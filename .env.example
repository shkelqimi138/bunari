EXPO_PUBLIC_API_BASE_URL=https://your-api.up.railway.app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Configure these in Railway, never with an EXPO_PUBLIC_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
# Optional: a Sign in with Apple key (Apple Developer › Keys), so Delete Profile also revokes Apple tokens.
APPLE_KEY_ID=your-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY=contents-of-the-p8-file
# Optional overrides; the server defaults to the app's own Apple team and bundle ID.
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_CLIENT_ID=your.bundle.id
ALLOWED_ORIGINS=https://your-web-preview.example
PORT=3000
