# Cloudflare Pages response headers.
# The site loads nothing from other hosts and has no inline styles or scripts; its one script, fonts and images are its own.
# X-Robots-Tag keeps the site out of search results until launch (after the legal review, once the
# App Store link works); remove it then (see docs/WEBSITE.md).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Robots-Tag: noindex

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
